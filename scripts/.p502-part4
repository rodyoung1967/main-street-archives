                   lambda m: m.group(1) + str(int(m.group(2)) + 1) + m.group(3), early, count=1)
    early = early.rstrip() + f'''\n\n## {IMG} — CCHS P-502 G. H. Young Store, 507 Main, cataloged 1916\n\n`{TARGET.name}` preserves the exact steward-supplied CCHS JPEG (SHA-256 `{EXPECTED_SHA}`). Institutional metadata supplies **507 Main** and **1916**; visible lettering supplies **G. H. Youngs Collection. Oregon City Ore.** The 1916 date/address must be reconciled with selected newspaper directory advertisements placing W. W. Bradley at 507. See `{SID}` / `{EID}` and the [source review](../../../{CAPTURE}).\n'''
    early_path.write_text(early, encoding="utf-8")

