# Remove temporary integration machinery from the final tree; the workflow keeps running after unlink.
for tmp in (Path("scripts/integrate_cchs_p502_gh_young.py"), Path(".github/workflows/integrate-cchs-p502-gh-young.yml")):
    try:
        tmp.unlink()
    except FileNotFoundError:
        pass

# Last internal integrity checks before the repository validator runs.
assert TARGET.exists() and TARGET.stat().st_size == EXPECTED_SIZE
assert hashlib.sha256(TARGET.read_bytes()).hexdigest() == EXPECTED_SHA
for path, token in (("evidence/source-register.md", SID), ("evidence/evidence-register.md", EID),
                    ("media/photo-metadata-register.md", IMG), ("database/sources.yml", SID),
                    ("database/evidence.yml", EID)):
    if token not in read(path):
        raise SystemExit(f"integration token {token} missing from {path}")
