def read(path):
    return Path(path).read_text(encoding="utf-8")


def write(path, text):
    Path(path).write_text(text, encoding="utf-8")


def append_once(path, marker, block):
    text = read(path)
    if marker not in text:
        write(path, text.rstrip() + "\n\n" + block.rstrip() + "\n")


def insert_before_once(path, before_heading, marker, block):
    text = read(path)
    if marker in text:
        return
    pos = text.find(before_heading)
    if pos < 0:
        write(path, text.rstrip() + "\n\n" + block.rstrip() + "\n")
        return
    write(path, text[:pos].rstrip() + "\n\n" + block.rstrip() + "\n\n" + text[pos:])


def yaml_block(path, ident):
    text = read(path)
    pattern = re.compile(r"(?ms)^  - id: " + re.escape(ident) + r"\n.*?(?=^  - id: |\Z)")
    m = pattern.search(text)
    if not m:
        raise SystemExit(f"missing YAML id {ident} in {path}")
    return text, m, m.group(0).rstrip()


def add_yaml_list_item(path, ident, field, value):
    text, m, block = yaml_block(path, ident)
    # Do nothing if the exact item is already present in a block-style or inline field.
    if re.search(r"(?m)^      -\s+" + re.escape(value) + r"\s*$", block) or re.search(
        r"(?m)^    " + re.escape(field) + r":\s*\[[^\]]*\b" + re.escape(value) + r"\b", block
    ):
        return
    # Existing block-style list. Child list items are indented six spaces beneath
    # the four-space entity field, matching the repository's YAML layout.
    fm = re.search(r"(?m)^(    " + re.escape(field) + r":\s*)$", block)
    if fm:
        start = fm.end()
        rest = block[start:]
        nm = re.search(r"(?m)^    [A-Za-z0-9_]+:\s*", rest)
        insert = start + (nm.start() if nm else len(rest))
        prefix = block[:insert].rstrip()
        suffix = block[insert:]
        block = prefix + f"\n      - {value}\n" + suffix.lstrip("\n")
    else:
        # Existing inline list.
        im = re.search(r"(?m)^(    " + re.escape(field) + r":\s*)\[([^\]]*)\]\s*$", block)
        if im:
            vals = [v.strip() for v in im.group(2).split(",") if v.strip()]
            vals.append(value)
            new_line = im.group(1) + "[" + ", ".join(vals) + "]"
            block = block[:im.start()] + new_line + block[im.end():]
        else:
            block = block.rstrip() + f"\n    {field}:\n      - {value}"
    new = block.rstrip() + "\n\n"
    write(path, text[:m.start()] + new + text[m.end():])


def http_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "main-street-archives/1.0"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.load(r)


def http_bytes(url):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 main-street-archives/1.0"})
    with urllib.request.urlopen(req, timeout=90) as r:
        return r.read()


def all_dicts(obj):
    if isinstance(obj, dict):
        yield obj
        for v in obj.values():
            yield from all_dicts(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from all_dicts(v)


def compact_strings(obj):
    vals = []
    if isinstance(obj, dict):
        for v in obj.values():
            vals.extend(compact_strings(v))
    elif isinstance(obj, list):
        for v in obj:
            vals.extend(compact_strings(v))
    elif isinstance(obj, (str, int, float)):
        vals.append(str(obj))
    return vals


def find_entry_candidates(search_obj):
    # Prefer the documented search tuple's entries resultset.
    candidates = []
    entries = search_obj.get("entries") if isinstance(search_obj, dict) else None
    if isinstance(entries, dict):
        vals = entries.get("results") or entries.get("items") or []
        if isinstance(vals, list):
            candidates.extend(v for v in vals if isinstance(v, dict))
    elif isinstance(entries, list):
        candidates.extend(v for v in entries if isinstance(v, dict))
